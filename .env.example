ENVIRONMENT=local

# Core API
SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=postgresql+psycopg://lifebridge:lifebridge@localhost:5432/lifebridge
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lifebridge
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_BASE_URL=http://localhost:9000/lifebridge

# Optional LLM provider used by case reasoning
GOOGLE_API_KEY=

# DigitalOcean Gradient runtime
# mock: deterministic local fallback
# live: requires valid token and workspace id
# auto: uses live if token is provided, otherwise mock
GRADIENT_RUNTIME_MODE=live
GRADIENT_ACCESS_TOKEN=
GRADIENT_WORKSPACE_ID=
GRADIENT_AGENT_ID=
GRADIENT_AGENT_ENDPOINT=
GRADIENT_AGENT_ACCESS_KEY=
GRADIENT_KNOWLEDGE_BASE_ID=
GRADIENT_DEFAULT_RETRIEVAL_K=8
GRADIENT_SUB_QUERY_RETRIEVAL_K=12
# Set true to hard-block DeepSeek-backed responses.
GRADIENT_DISALLOW_DEEPSEEK_MODEL=false
# Optional comma-separated allowlist, e.g. "gpt-4.1,claude-3.7".
GRADIENT_ALLOWED_MODEL_PATTERNS=

# Frontend runtime
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional internal services when running full stack
TRACKER_API_URL=http://localhost:3100
DOCGEN_API_URL=http://localhost:8001
